# PORT=5000
# Set NODE_ENV=production on the deployed API; use development locally.
# NODE_ENV=development
# MONGO_URI=mongodb://127.0.0.1:27017/prinelva_blog
# JWT_SECRET=replace_with_a_long_random_secret
# Google OAuth Web client ID (same value as client VITE_GOOGLE_CLIENT_ID).
# GOOGLE_CLIENT_ID=
# CLIENT_URL=http://localhost:5173
# API_PUBLIC_URL=http://localhost:5000
# Set TRUST_PROXY=1 when running behind one trusted reverse proxy in production.
# TRUST_PROXY=
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
# Audio/video uploads use Cloudinary's video resource type and are limited to 100 MB per file.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM=Blog <no-reply@example.com>
# ADMIN_EMAIL=
# ADMIN_PASSWORD=
